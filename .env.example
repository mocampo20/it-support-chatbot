# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Required (unless MOCK_MODE=true)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: Claude model to use (default: claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5

# Optional: maximum tokens per Claude response, including thinking (default: 16000)
CLAUDE_MAX_TOKENS=16000

# Optional: true = return a fake answer without calling the API (no credits used)
MOCK_MODE=false

# Optional: retry refused requests on a fallback model (default: true).
# Set to false if your chosen model does not support server-side fallbacks.
ENABLE_REFUSAL_FALLBACK=true

# ---------------------------------------------------------------------------
# RAG (Retrieval Augmented Generation) with Voyage AI + ChromaDB
# ---------------------------------------------------------------------------

# Required for live embeddings (unless MOCK_EMBEDDINGS=true)
VOYAGE_API_KEY=your-voyage-api-key-here

# Optional: true = search the knowledge base before answering (default: true)
RAG_ENABLED=true

# Optional: Voyage AI embedding model (default: voyage-4).
# Changing it creates a new collection and re-embeds the knowledge base.
VOYAGE_EMBEDDING_MODEL=voyage-4

# Optional: true = deterministic local mock embeddings (no Voyage calls).
# Defaults to the value of MOCK_MODE when not set.
# MOCK_EMBEDDINGS=true

# Optional: knowledge base file and vector database folder
RAG_KB_PATH=it_sector.txt
CHROMA_DB_PATH=chroma_db

# Optional: number of chunks to retrieve and minimum cosine similarity (0-1)
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.2

# Optional: maximum characters per knowledge base chunk
RAG_MAX_CHUNK_CHARS=1500

# ---------------------------------------------------------------------------
# Tools (server tool: web search, client tool: get_current_datetime)
# ---------------------------------------------------------------------------

# Optional: true = give Claude the tools in the Streamlit app (default: true)
TOOLS_ENABLED=true

# Optional: true = allow Anthropic's web search server tool (default: true).
# Web searches are billed per search in live mode; mock mode never searches.
WEB_SEARCH_ENABLED=true

# Optional: maximum web searches per answer (default: 3)
WEB_SEARCH_MAX_USES=3

# Optional: web search tool version (default: web_search_20260209).
# Use web_search_20250305 for older models that do not support the newer version.
WEB_SEARCH_TOOL_VERSION=web_search_20260209

# Optional: maximum Claude calls in one tool loop, to prevent infinite loops (default: 5)
MAX_TOOL_ITERATIONS=5

# ---------------------------------------------------------------------------
# MCP ticket server (local, stdio transport, SQLite storage)
# ---------------------------------------------------------------------------

# Optional: true = start the MCP ticket server and expose create_ticket and
# get_status_ticket (default: true). Also requires TOOLS_ENABLED=true.
MCP_ENABLED=true

# Optional: SQLite ticket database (default: tickets.db, relative to the project folder).
# Keep the .db extension so the file stays ignored by Git.
TICKET_DB_PATH=tickets.db

# Optional: seconds to wait for the MCP server to start or answer a tool call (default: 20)
MCP_TIMEOUT_SECONDS=20
